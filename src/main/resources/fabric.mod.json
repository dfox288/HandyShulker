{
	"schemaVersion": 1,
	"id": "handyshulker",
	"version": "${version}",
	"name": "Handy Shulker",
	"description": "Shulker boxes should work like bundles. Click to insert items, hover to preview contents, and scroll to extract - all without placing the box down.",
	"authors": [
		"D.Fox"
	],
	"contact": {
		"homepage": "https://github.com/dfox288/HandyShulker",
		"sources": "https://github.com/dfox288/HandyShulker",
		"issues": "https://github.com/dfox288/HandyShulker/issues"
	},
	"license": "MIT",
	"icon": "assets/handyshulker/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.handy.mods.handyshulker.HandyShulker"
		],
		"client": [
			"dev.handy.mods.handyshulker.client.HandyShulkerClient"
		],
		"modmenu": [
			"dev.handy.mods.handyshulker.client.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"handyshulker.mixins.json",
		{
			"config": "handyshulker.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": ">=26.2-alpha.1",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": ">=18.0.0",
		"yet_another_config_lib_v3": "*"
	}
}
